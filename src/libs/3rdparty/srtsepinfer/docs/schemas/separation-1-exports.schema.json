{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SynthRT Separation Inference Level 1 exports",
  "type": "object",
  "additionalProperties": false,
  "required": ["sampleRate", "channelCount", "tracks"],
  "properties": {
    "sampleRate": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "channelCount": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "maxSegmentDuration": {"type": "number", "minimum": 0, "default": 0},
    "tracks": {
      "type": "array", "minItems": 1,
      "description": "Ordered output sources. Each id must also be unique; the runtime enforces this cross-item rule.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "object", "required": ["_"], "propertyNames": {"minLength": 1}, "additionalProperties": {"type": "string", "minLength": 1}}
            ]
          }
        }
      }
    }
  }
}
